{
  "manifest_version": 3,
  "name": "TubeCourier for MeTube",
  "version": "1.0.0",
  "description": "Companion extension specifically designed for MeTube (yt-dlp). Send video downloads with custom subfolder selection, real-time WebSocket progress tracking, cookie sync, and notifications.",
  "author": "covarianttensor",
  "homepage_url": "https://github.com/covarianttensor/TubeCourier",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png",
    "256": "icons/icon-256.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "TubeCourier for MeTube",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png",
      "128": "icons/icon-128.png",
      "256": "icons/icon-256.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "cookies",
    "tabs",
    "activeTab",
    "storage",
    "notifications",
    "contextMenus",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
